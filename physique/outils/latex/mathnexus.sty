 \node {\fontsize{16}{18}\selectfont $\displaystyle\lim_{x\to 0}\frac{\sin x}{x}=1$};
\or % 21 case du tableau périodique
 \draw (-0.55,-0.55) rectangle (0.55,0.55);
 \node at (-0.33,0.36) {\fontsize{8}{9}\selectfont 6};
 \node at (0,-0.02) {\fontsize{24}{26}\selectfont C};
 \node at (0,-0.37) {\fontsize{6}{7}\selectfont Carbone};
\or % 22 dérivée
 \node {\fontsize{20}{22}\selectfont $\dfrac{\mathrm{d}y}{\mathrm{d}x}$};
\fi}

% Grille décalée de symboles (déterministe)
\newcommand{\mnwatermark}[2]{%
\begin{tikzpicture}[overlay,color=#1,line width=0.5pt,line cap=round,line join=round]
\begin{scope}
#2
\foreach \mnr in {0,...,7}{%
 \foreach \mnc in {0,...,4}{%
  \pgfmathtruncatemacro{\mnk}{mod(\mnr*5+\mnc*3+\mnr*\mnc,23)}%
  \pgfmathsetmacro{\mnpx}{\mnc*4.2+mod(\mnr,2)*2.1+0.3+mod(\mnr*7+\mnc*11,9)*0.12}%
  \pgfmathsetmacro{\mnpy}{\mnr*3.9+1.2+mod(\mnr*3+\mnc*5,7)*0.1}%
  \pgfmathsetmacro{\mnpa}{mod(\mnk*53+\mnr*17,31)-15}%
  \pic[transform shape,rotate=\mnpa] at (\mnpx,\mnpy) {mnsym=\mnk};%
 }}
\end{scope}
\end{tikzpicture}}

