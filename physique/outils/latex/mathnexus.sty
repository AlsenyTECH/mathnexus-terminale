 \fill (0,0) circle (0.09);
\or % 1 intégrale
 \node {\fontsize{22}{24}\selectfont $\displaystyle\int_a^b f(x)\,\mathrm{d}x$};
\or % 2 benzène
 \draw (0:0.8)--(60:0.8)--(120:0.8)--(180:0.8)--(240:0.8)--(300:0.8)--cycle;
 \draw (0,0) circle (0.52);
\or % 3 erlenmeyer
 \draw (-0.18,0.9)--(-0.18,0.3)--(-0.78,-0.75)--(0.78,-0.75)--(0.18,0.3)--(0.18,0.9);
 \draw (-0.28,0.9)--(0.28,0.9);
 \draw (-0.49,-0.25) to[bend left=12] (0.49,-0.25);
 \draw (-0.15,-0.55) circle (0.07) (0.18,-0.45) circle (0.05);
\or % 4 somme
 \node {\fontsize{20}{22}\selectfont $\displaystyle\sum_{n=1}^{\infty}\frac{1}{n^{2}}=\frac{\pi^{2}}{6}$};
\or % 5 onde sinusoïdale
 \draw[->] (-1,0)--(1.05,0); \draw[->] (-0.9,-0.65)--(-0.9,0.65);
 \draw[smooth,samples=40,domain=-0.9:1] plot (\x,{0.42*sin((\x+0.9)*270)});
\or % 6 pythagore
 \draw (-0.8,-0.55)--(0.8,-0.55)--(0.8,0.5)--cycle;
 \draw (0.6,-0.55)--(0.6,-0.35)--(0.8,-0.35);
 \node at (0,-0.85) {\fontsize{12}{13}\selectfont $a^{2}+b^{2}=c^{2}$};
\or % 7 pendule
 \draw (-0.6,0.9)--(0.6,0.9);
 \draw (0,0.9)--(0.5,-0.55); \draw (0.5,-0.55) circle (0.14);
 \draw[dashed] (0,0.9)--(0,-0.7);
 \draw (0,0.2) arc (-90:-70:1.1);
\or % 8 E = mc2
 \node {\fontsize{24}{26}\selectfont $E=mc^{2}$};
\or % 9 bécher
 \draw[rounded corners=3pt] (-0.55,0.8)--(-0.55,-0.75)--(0.55,-0.75)--(0.55,0.8);
 \draw (-0.65,0.8)--(0.65,0.8);
 \draw (-0.55,0.4)--(-0.35,0.4) (-0.55,0.1)--(-0.35,0.1) (-0.55,-0.2)--(-0.35,-0.2);
 \draw (-0.55,-0.1)--(0.55,-0.1);
\or % 10 circuit
 \draw (-0.9,-0.5)--(0.9,-0.5)--(0.9,0.5)--(0.45,0.5)--(0.38,0.7)--(0.24,0.3)--(0.1,0.7)--(-0.04,0.3)--(-0.18,0.7)--(-0.25,0.5)--(-0.9,0.5)--(-0.9,0.12);
 \draw (-1.05,0.12)--(-0.75,0.12) (-1.0,-0.04)--(-0.8,-0.04);
 \draw (-0.9,-0.04)--(-0.9,-0.5);
\or % 11 pi
 \node {\fontsize{36}{38}\selectfont $\pi$};
\or % 12 lentille
 \draw (0,-0.9) to[bend left=35] (0,0.9) to[bend left=35] (0,-0.9);
 \draw[dashed] (-1,0)--(1.05,0);
 \draw (-1,0.5)--(0,0.5)--(0.95,0); \draw (-1,-0.5)--(0,-0.5)--(0.95,0);
\or % 13 force
 \node {\fontsize{22}{24}\selectfont $\vec{F}=m\,\vec{a}$};
\or % 14 alcool (squelette)
 \draw (-0.9,-0.2)--(-0.3,0.15)--(0.3,-0.2)--(0.8,0.1);
 \node at (1.08,0.18) {\fontsize{12}{13}\selectfont OH};
\or % 15 discriminant
 \node {\fontsize{16}{18}\selectfont $x=\dfrac{-b\pm\sqrt{\Delta}}{2a}$};
\or % 16 parabole
 \draw[->] (-0.9,0)--(1,0); \draw[->] (0,-0.7)--(0,0.95);
 \draw[smooth,samples=30,domain=-0.75:0.75] plot (\x,{1.1*\x*\x-0.5});
\or % 17 pH
 \node {\fontsize{15}{17}\selectfont $\mathrm{pH}=-\log\,[\mathrm{H_3O^{+}}]$};
\or % 18 infini
 \node {\fontsize{40}{42}\selectfont $\infty$};
\or % 19 ressort
 \draw (-0.9,-0.45)--(-0.9,0.45);
 \draw (-0.9,0)--(-0.7,0)--(-0.6,0.25)--(-0.45,-0.25)--(-0.3,0.25)--(-0.15,-0.25)--(0,0.25)--(0.1,0)--(0.15,0);
 \draw (0.15,-0.28) rectangle (0.75,0.28);
