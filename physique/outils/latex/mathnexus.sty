% Niveau de difficulté : \niveau{3} -> ●●●○○
\newcommand{\niveau}[1]{{\color{mnblue}\foreach\i in {1,...,5}{\ifnum\i>#1 {\color{mnblue!55}$\circ$}\else$\bullet$\fi}}}

% Exercice : \exo{Titre}  ou  \exo[3]{Titre} (avec niveau de difficulté)
\newcounter{mnexo}
\newcommand{\exo}[2][]{\par\bigskip\refstepcounter{mnexo}\noindent
  {\sffamily\bfseries\color{mnblue}Exercice\,\themnexo}%
  \ifstrempty{#2}{}{\,{\sffamily\bfseries\color{mnnavy}:\ #2}}%
  \ifstrempty{#1}{}{\hfill\niveau{#1}}\par\nointerlineskip
  {\color{mnnavy!22}\noindent\rule{\linewidth}{0.4pt}}\par\smallskip}

% Application directe (cours)
\newtcolorbox{appli}[1][]{enhanced,breakable,colback=white,colframe=mnblue,boxrule=0.6pt,arc=2pt,
  title={Application directe\ifstrempty{#1}{}{\,--\,#1}},
  fonttitle=\sffamily\bfseries\small,coltitle=mnblue,colbacktitle=mnblue!8}

% Définition / propriété / méthode / remarque
\newcommand{\mnlab}[3]{{\sffamily\bfseries\color{#1}#2\ifstrempty{#3}{}{\,(#3)}.}\ }
\newtcolorbox{defin}[1][]{enhanced,breakable,frame hidden,sharp corners,colback=mnblue!4,
  borderline west={2.6pt}{0pt}{mnblue},left=10pt,before upper={\mnlab{mnblue}{Définition}{#1}}}
\newtcolorbox{propr}[1][]{enhanced,breakable,colback=white,colframe=mnnavy,boxrule=0.6pt,arc=2pt,
  before upper={\mnlab{mnnavy}{Propriété}{#1}}}
\newtcolorbox{methode}[1][]{enhanced,breakable,frame hidden,sharp corners,colback=white,
  borderline west={2.6pt}{0pt}{mnnavy},left=10pt,before upper={\mnlab{mnnavy}{Méthode}{#1}}}
\newtcolorbox{rem}{enhanced,breakable,frame hidden,sharp corners,colback=white,
  borderline west={0.6pt}{0pt}{mngrey},left=10pt,before upper={\mnlab{mngrey}{Remarque}{}}}

% ============================================================
%  FORMAT « BAC GUIDÉ » (barème, questions numérotées, a) b) c))
%  \exobac[niveau]{points}{Titre}   -> EXERCICE n (7 points) Titre
%  \contexte{...}                   -> ligne de contexte en italique
%  environnement questions : \qt{Titre de la question} puis sousq
%  environnement sousq     : \item texte \pts{0,5}
% ============================================================
\newcommand{\exobac}[3][]{\par\Needspace{7\baselineskip}\bigskip\refstepcounter{mnexo}\noindent
  {\sffamily\bfseries\large\color{mnblue}EXERCICE\,\themnexo}\quad
  {\sffamily\bfseries\large\color{mnnavy}(#2\,points)}\quad
  {\sffamily\bfseries\large\color{mnnavy}#3}%
  \ifstrempty{#1}{}{\hfill\niveau{#1}}\par\nointerlineskip
  {\color{mnblue}\noindent\rule{\linewidth}{0.8pt}}\par\smallskip}
\newcommand{\contexte}[1]{\noindent{\small\itshape\color{mngrey}#1}\par\smallskip}
\newcommand{\pts}[1]{\hfill\mbox{\bfseries(#1\,pt)}}
\newenvironment{questions}{\begin{enumerate}[label=\bfseries\arabic*.,leftmargin=1.5em,itemsep=4pt,topsep=4pt]}{\end{enumerate}}
\newenvironment{sousq}{\begin{enumerate}[label=\alph*),leftmargin=2em,itemsep=2pt,topsep=3pt]}{\end{enumerate}}
\newcommand{\qt}[1]{\item\textbf{#1}}
% phrase d'accroche sous le bloc de titre de série
\newcommand{\mnaccroche}[1]{\begin{center}{\small\itshape\color{mngrey}#1}\end{center}\vspace{-4pt}}

% ============================================================
%  CHIMIE : \fx{CH_3-CH_2-OH}  (formules en romain, trait d'union réel)
% ============================================================
\newcommand{\fx}[1]{\ensuremath{\begingroup\mathcode`\-="002D \mathrm{#1}\endgroup}}
% Flèches de réaction
\newcommand{\rxn}[1]{\xrightarrow{\ #1\ }}

