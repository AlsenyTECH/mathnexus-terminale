% ============================================================
%  LOGO : atome + personnage lisant (TikZ)
%  \mnicon[échelle]{couleur traits}{couleur livre}{couleur fond}
%  échelle 1 = 5,6 cm de haut
% ============================================================
\newcommand{\mnicon}[4][1]{%
  \begin{tikzpicture}[scale=0.01*#1,line cap=round,line join=round]
    \pgfmathsetlengthmacro{\mnlw}{0.12*#1 cm}
    \draw[#2,line width=\mnlw] (0,5) ellipse (118 and 280);
    \draw[#2,line width=\mnlw,rotate around={30:(0,-15)}] (0,-15) ellipse (282 and 110);
    \draw[#2,line width=\mnlw,rotate around={-30:(0,-15)}] (0,-15) ellipse (282 and 110);
    \fill[#4] (-116,38)--(-116,-175)--(-72,-175)--(0,-203)--(72,-175)--(116,-175)--(116,38)--cycle;
    \draw[#2,line width=\mnlw] (-116,38)--(-116,-175)--(-72,-175)--(0,-203)--(72,-175)--(116,-175)--(116,38);
    \fill[#2] (0,13) circle (57);
    \fill[#3] (-98,-50)--(-5,-62)--(-5,-183)--(-98,-148)--cycle;
    \fill[#3] (98,-50)--(5,-62)--(5,-183)--(98,-148)--cycle;
    \draw[#2,line width=\mnlw,fill=#4] (-243,71) circle (17);
  \end{tikzpicture}%
}

