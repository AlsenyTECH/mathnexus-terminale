% Titre de partie : carré d'accent + filet
\newcommand{\sujet}[1]{\par\Needspace{9\baselineskip}\vspace{10pt}\noindent
  {\color{mnblue}\rule[0.02em]{0.6em}{0.6em}}\hspace{0.5em}%
  {\sffamily\bfseries\large\color{mnnavy}#1}\par\nointerlineskip\vspace{2pt}\noindent
